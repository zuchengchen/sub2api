[Unit]
Description=Sub2API YuFeng XGuard llama.cpp moderation endpoint
Documentation=https://github.com/ggml-org/llama.cpp/releases/tag/b10430
After=network.target
Wants=network.target

[Service]
Type=simple
User=sub2api-moderation
Group=sub2api-moderation
WorkingDirectory=/opt/sub2api
Environment=LLAMA_CPP_DIR=/opt/llama.cpp/b10430
Environment=YUFENG_MODEL_PATH=/var/lib/sub2api/models/YuFeng-XGuard-Reason-0.6B.Q4_K_M.gguf
Environment=YUFENG_BIND_ADDRESS=127.0.0.1
Environment=YUFENG_PORT=8088
EnvironmentFile=-/etc/sub2api/yufeng-xguard.env
ExecStart=/opt/sub2api/scripts/content-moderation/run-yufeng-llama.sh
ExecStartPost=/opt/sub2api/scripts/content-moderation/check-yufeng-health.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=30s
KillSignal=SIGINT
LimitNOFILE=65536

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
UMask=0077

[Install]
WantedBy=multi-user.target
