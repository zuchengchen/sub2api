map $http_upgrade $connection_upgrade {
    default upgrade;
    '' '';
}

upstream sub2api_backend {
    server 127.0.0.1:8080;
    keepalive 128;
    keepalive_requests 10000;
    keepalive_timeout 60s;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name mofa.love.gd _;

    return 301 https://$host$request_uri;
}


server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name mofa.love.gd _;

    client_max_body_size 256m;

    ssl_certificate /etc/letsencrypt/live/mofa.love.gd-managed/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mofa.love.gd-managed/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # elysiver responses normalizer (Grok CLI created_at patch)
    location ^~ /elysiver-norm/ {
        proxy_pass http://127.0.0.1:18081/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Grok Imagine Video: domestic clients cannot reach vidgen.x.ai.
    # Stream the official bucket through this host. Must beat the SPA fallback.
    location ^~ /v1/media/vidgen/xai-vidgen-bucket/ {
        proxy_ssl_server_name on;
        proxy_ssl_name vidgen.x.ai;
        proxy_set_header Host vidgen.x.ai;
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_hide_header Content-Disposition;
        proxy_pass https://vidgen.x.ai/xai-vidgen-bucket/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 15s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        add_header X-Accel-Buffering no;
    }

    location ^~ /v1/media/vidgen/ {
        default_type text/plain;
        return 404;
    }

    location ^~ /v1/media/imgen/ {
        proxy_ssl_server_name on;
        proxy_ssl_name imgen.x.ai;
        proxy_set_header Host imgen.x.ai;
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_pass https://imgen.x.ai/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 15s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        add_header X-Accel-Buffering no;
    }

    # Do not let unknown media-looking paths fall through to the frontend SPA.
    location = /xai-vidgen-bucket { default_type text/plain; return 404; }
    location ^~ /xai-vidgen-bucket/ { default_type text/plain; return 404; }

    # Rewrite official CDN hosts in video JSON so Grok CLI downloads via /v1/media/.
    # sub_filter only applies to application/json; mp4 /content streams are untouched.
    location ~ ^/(?:v1/)?videos(?:/|$) {
        proxy_pass http://sub2api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Accept-Encoding "";

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        sub_filter_types application/json;
        sub_filter_once off;
        sub_filter 'https://vidgen.x.ai/' 'https://$host/v1/media/vidgen/';
        sub_filter 'https://imgen.x.ai/' 'https://$host/v1/media/imgen/';
    }

    # 防爆破：登录/注册/找回密码
    location ~ ^/api/v1/auth/(login|register|reset-password|forgot-password) {
        limit_req zone=sub2api_auth burst=5 nodelay;

        proxy_pass http://sub2api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://sub2api_backend;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        proxy_socket_keepalive on;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
